# Backup only the port project, not the full local working directory.
/*
!/.gitignore
!/.gitattributes
!/README_BACKUP.md
!/outputs/
/outputs/*
!/outputs/Melee360/

# Builds, packaged game, logs/captures and caches.
/outputs/Melee360/build/
/outputs/Melee360/Debug/
/outputs/Melee360/package/
/outputs/Melee360/logs/
**/__pycache__/
**/ipch/
*.zip
*.7z
*.obj
*.lib
*.exe
*.dll
*.xex
*.xdb
*.pdb
*.ilk
*.suo
*.user
*.sdf
*.pyc

# Game images/assets/saves, including locally extracted fonts.
*.iso
*.gcm
*.rvz
*.dol
*.elf
*.dat
*.usd
*.ssm
*.hps
*.thp
*.mth
*.gci
*.raw
*.m360card
*.bin
*.tga
*.png
*.jpg
*.mp4
*.wav
*.pcm
/outputs/Melee360/compat/sysdolphin/baselib/sislib_font.inc
/outputs/Melee360/compat/sysdolphin/baselib/debug_font.inc
/outputs/Melee360/src/menu_font.h

# Compiled shader bytecode; keep HLSL sources and compilation scripts.
/outputs/Melee360/src/*_VS.h
/outputs/Melee360/src/*_PS.h