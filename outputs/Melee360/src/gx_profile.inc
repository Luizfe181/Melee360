/* Opt-in counters. Timings are CPU wall time, including blocked GPU waits. */
namespace {
struct GXProfile {bool enabled,detail,noDraw,simpleShader,whiteTextures,noCopy;unsigned frames,draws,earlyTriangles,uploads,copies,invalidations,cacheHits,constantRequests,constantWrites,constantRegisters,cacheEntries,cacheBytes,bindingReuses,vertices,idleCalls;LONGLONG packetStart,packetTicks,submitTicks,drawTicks,idleTicks,filterTicks;LONGLONG uploadTicks,copyTicks,pipelineTicks,logicTicks,renderTicks,presentTicks;LARGE_INTEGER frequency;} gxProfile;
LONGLONG profileNow(){LARGE_INTEGER now;QueryPerformanceCounter(&now);return now.QuadPart;}
/* Separate display-list work from packet timing. Execution includes nested
 * vertex processing and draws; these totals must not be added to packet_ms. */
struct GXDisplayListProfile {unsigned calls,bytes,commands,vertices;LONGLONG preflightTicks,executionTicks;} displayListProfile;
struct GXVertexSample {unsigned calls,samples;LONGLONG ticks;};
GXVertexSample vertexSamples[4];bool vertexSampling;unsigned vertexSamplePhase;
struct GXVertexTimer {GXVertexSample* sample;LONGLONG start;
 GXVertexTimer(unsigned kind):sample(0),start(0){if(gxProfile.enabled&&vertexSampling){GXVertexSample& s=vertexSamples[kind];unsigned index=s.calls++;if((index&63)==vertexSamplePhase){sample=&s;++s.samples;start=profileNow();}}}
 ~GXVertexTimer(){if(sample)sample->ticks+=profileNow()-start;}
};
struct GXDetailTimer {LONGLONG* total;LONGLONG start;GXDetailTimer(LONGLONG* value):total(gxProfile.enabled&&gxProfile.detail?value:0),start(total?profileNow():0){}~GXDetailTimer(){if(total)*total+=profileNow()-start;}};
struct GXProfileTimer {LONGLONG* total;LONGLONG start;GXProfileTimer(LONGLONG* value):total(gxProfile.enabled?value:0),start(total?profileNow():0){}~GXProfileTimer(){if(total)*total+=profileNow()-start;}};
}
extern "C" void Melee360GXProfileEnable(int enabled){memset(&gxProfile,0,sizeof(gxProfile));memset(&displayListProfile,0,sizeof(displayListProfile));gxProfile.enabled=enabled!=0;gxProfile.detail=GetFileAttributesA("game:\\gx-profile-detail.flag")!=((DWORD)-1);gxProfile.noDraw=gxProfile.enabled&&GetFileAttributesA("game:\\gx-diag-no-draw.flag")!=((DWORD)-1);gxProfile.simpleShader=gxProfile.enabled&&GetFileAttributesA("game:\\gx-diag-simple-shader.flag")!=((DWORD)-1);gxProfile.whiteTextures=gxProfile.enabled&&GetFileAttributesA("game:\\gx-diag-white-textures.flag")!=((DWORD)-1);gxProfile.noCopy=gxProfile.enabled&&GetFileAttributesA("game:\\gx-diag-no-copy.flag")!=((DWORD)-1);QueryPerformanceFrequency(&gxProfile.frequency);memset(vertexSamples,0,sizeof(vertexSamples));vertexSampling=GetFileAttributesA("game:\\gx-profile-vertex.flag")!=((DWORD)-1);vertexSamplePhase=GetFileAttributesA("game:\\gx-profile-vertex-alt.flag")!=((DWORD)-1)?31:0;}
extern "C" void Melee360GXProfileFrame(LONGLONG logic,LONGLONG render,LONGLONG present){
 if(!gxProfile.enabled)return;gxProfile.logicTicks+=logic;gxProfile.renderTicks+=render;gxProfile.presentTicks+=present;
 if(++gxProfile.frames%60==0){double scale=1000.0/gxProfile.frequency.QuadPart/gxProfile.frames;char message[768];sprintf_s(message,sizeof(message),"GX profile: frames=%u logic_ms=%.3f render_ms=%.3f present_ms=%.3f upload_ms=%.3f copy_ms=%.3f draws=%u early_triangles=%u uploads=%u copies=%u invalidations=%u cache_hits=%u pipeline_ms=%.3f constant_requests=%u constant_writes=%u constant_registers=%u cache_entries=%u cache_bytes=%u binding_reuses=%u\n",gxProfile.frames,gxProfile.logicTicks*scale,gxProfile.renderTicks*scale,gxProfile.presentTicks*scale,gxProfile.uploadTicks*scale,gxProfile.copyTicks*scale,gxProfile.draws,gxProfile.earlyTriangles,gxProfile.uploads,gxProfile.copies,gxProfile.invalidations,gxProfile.cacheHits,gxProfile.pipelineTicks*scale,gxProfile.constantRequests,gxProfile.constantWrites,gxProfile.constantRegisters,gxProfile.cacheEntries,gxProfile.cacheBytes,gxProfile.bindingReuses);Melee360Log(message);
 if(gxProfile.detail){sprintf_s(message,sizeof(message),"GX detail: frames=%u packet_ms=%.3f submit_ms=%.3f draw_api_ms=%.3f idle_ms=%.3f filter_ms=%.3f vertices=%u idle_calls=%u\n",gxProfile.frames,gxProfile.packetTicks*scale,gxProfile.submitTicks*scale,gxProfile.drawTicks*scale,gxProfile.idleTicks*scale,gxProfile.filterTicks*scale,gxProfile.vertices,gxProfile.idleCalls);Melee360Log(message);}
 if(gxProfile.detail){sprintf_s(message,sizeof(message),"GX display lists: frames=%u calls=%u bytes=%u commands=%u vertices=%u preflight_ms=%.3f execution_ms=%.3f\n",gxProfile.frames,displayListProfile.calls,displayListProfile.bytes,displayListProfile.commands,displayListProfile.vertices,displayListProfile.preflightTicks*scale,displayListProfile.executionTicks*scale);Melee360Log(message);}
 Melee360GXNativeReport(gxProfile.frames);
 if(vertexSampling){const char* names[4]={"position","lighting","texgen","normal"};for(unsigned i=0;i<4;++i){GXVertexSample& v=vertexSamples[i];double estimate=v.samples?v.ticks*scale*v.calls/v.samples:0;sprintf_s(message,sizeof(message),"GX vertex sample: frames=%u phase=%u kind=%s calls=%u samples=%u sampled_ticks=%I64d estimated_ms=%.3f\n",gxProfile.frames,vertexSamplePhase,names[i],v.calls,v.samples,v.ticks,estimate);Melee360Log(message);}}}
}
